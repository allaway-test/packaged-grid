# Environment variables for Docker deployment
VITE_DATA_ENDPOINT=https://your-api.example.com/api/data
VITE_AI_ENDPOINT=https://your-ai-service.example.com/api/chat
VITE_AI_API_KEY=your_ai_api_key_here

# Backend API URL for nginx proxy
BACKEND_API_URL=https://your-backend.example.com

# Custom configuration file path
CONFIG_FILE=./your-custom-config.json

# Database and other backend configurations (if using the example backend)
DATABASE_URL=postgresql://user:password@db:5432/packaged_grid
BACKEND_API_KEY=your_backend_api_key